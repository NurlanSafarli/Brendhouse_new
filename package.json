{
  "name": "brendhouse",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @brendhouse/storefront",
    "build": "npm run build -w @brendhouse/storefront && npm run build -w @brendhouse/api",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p apps/storefront/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/admin/tsconfig.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "import:catalog": "tsx scripts/import.ts",
    "test:browser": "playwright test",
    "dev:preview": "ENABLE_UNVERIFIED_CATALOG=true npm run dev -w @brendhouse/storefront -- --port 3001",
    "build:frontend": "npm run build -w @brendhouse/storefront && npm run build -w @brendhouse/admin",
    "test:preview": "playwright test --config playwright.development.config.ts",
    "dev:admin": "ENABLE_ADMIN_PREVIEW=true npm run dev -w @brendhouse/admin",
    "build:pages": "node scripts/build-pages.mjs",
    "test:pages": "node scripts/test-pages.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "vitest": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.20.0",
    "@playwright/test": "^1.58.0",
    "prettier": "^3.6.0"
  }
}
