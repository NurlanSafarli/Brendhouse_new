generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Verification {
  UNVERIFIED
  VERIFIED
}
enum Publication {
  DRAFT
  PUBLISHED
}
model Product {
  id String @id @default(cuid())
  source String
  sourceId String
  code String @unique
  slug String @unique
  verification Verification @default(UNVERIFIED)
  publication Publication @default(DRAFT)
  developmentOnly Boolean @default(false)
  verifiedBy String?
  verifiedAt DateTime?
  categoryId String?
  category Category? @relation(fields: [categoryId], references: [id])
  translations ProductTranslation[]
  variants Variant[]
  attributes AttributeVerification[]
  media Media[]
  collections Collection[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([source, sourceId])
}
model ProductTranslation {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale String
  title String
  description String?
  @@unique([productId, locale])
}
model Category {
  id String @id @default(cuid())
  slug String @unique
  name String
  section String
  type String
  products Product[]
  guides SizeGuide[]
}
model Collection {
  id String @id @default(cuid())
  slug String @unique
  name String
  products Product[]
}
model AttributeVerification {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key String
  value Json
  source String
  verification Verification @default(UNVERIFIED)
  verifiedBy String?
  verifiedAt DateTime?
  @@unique([productId,key])
}
model Media {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  objectKey String
  alt String
  source String
  verification Verification @default(UNVERIFIED)
}
model SizeGuide {
  id String @id @default(cuid())
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  revisions SizeGuideRevision[]
}
model SizeGuideRevision {
  id String @id @default(cuid())
  guideId String
  guide SizeGuide @relation(fields: [guideId], references: [id])
  version Int
  rows Json
  disclaimer String
  verification Verification @default(UNVERIFIED)
  developmentOnly Boolean @default(false)
  source String
  verifiedBy String?
  verifiedAt DateTime?
  @@unique([guideId,version])
}
model Variant {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id])
  color String
  size String
  barcode String @unique
  price Int
  oldPrice Int?
  balances InventoryBalance[]
  reservations InventoryReservation[]
  @@unique([productId,color,size])
}
model Branch {
  id String @id @default(cuid())
  sourceId String @unique
  name String
  address String?
  phone String?
  hours Json?
  verification Verification @default(UNVERIFIED)
  balances InventoryBalance[]
  reservations InventoryReservation[]
}
model InventoryBalance {
  id String @id @default(cuid())
  variantId String
  variant Variant @relation(fields: [variantId], references: [id])
  branchId String
  branch Branch @relation(fields: [branchId], references: [id])
  onHand Int @default(0)
  reserved Int @default(0)
  version Int @default(0)
  source String
  updatedAt DateTime @updatedAt
  @@unique([variantId,branchId])
}
model InventoryReservation {
  id String @id @default(cuid())
  variantId String
  variant Variant @relation(fields: [variantId], references: [id])
  branchId String
  branch Branch @relation(fields: [branchId], references: [id])
  cartId String
  quantity Int
  expiresAt DateTime
  status String @default("HELD")
  idempotencyKey String @unique
}
model PolicySet {
  id String @id @default(cuid())
  version Int @unique
  status String @default("DRAFT")
  approvedBy String?
  approvedAt DateTime?
  effectiveAt DateTime?
  deliveryRules Json
  returnDays Int?
  doorInspection Boolean?
  acceptedMethods Json
  guarantee String?
  loyaltyTerms Json?
  createdAt DateTime @default(now())
}
model ImportRun {
  id String @id @default(cuid())
  source String
  createdAt DateTime @default(now())
  accepted Int @default(0)
  rejected Int @default(0)
  errors Json
}
model OutboxEvent {
  id String @id @default(cuid())
  topic String
  aggregateId String
  payload Json
  createdAt DateTime @default(now())
  processedAt DateTime?
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  deadLetteredAt DateTime?
  @@index([processedAt,nextAttemptAt])
}
model AuditEvent {
  id String @id @default(cuid())
  actorId String
  action String
  entityId String
  reason String
  metadata Json
  createdAt DateTime @default(now())
}
