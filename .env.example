# Local development only. Use your own password; never commit .env.
DATABASE_URL=postgresql://brendhouse:CHANGE_ME@127.0.0.1:5432/brendhouse
POSTGRES_PASSWORD=CHANGE_ME
REDIS_URL=redis://127.0.0.1:6379
MEILISEARCH_URL=http://127.0.0.1:7700
MEILI_MASTER_KEY=CHANGE_ME_AT_LEAST_16_CHARACTERS
PORT=4000
# External SMS, payment, POS and storage adapters remain disabled until selected.
# Server-only address; leave unset until the catalog API is implemented and verified.
COMMERCE_API_URL=
# Only effective with NODE_ENV=development; never enables production fixtures.
ENABLE_UNVERIFIED_CATALOG=false
# Keep false until production launch review; preview routes stay noindex.
SITE_INDEXABLE=false
# Admin UI sandbox only; never grants real authorization.
ENABLE_ADMIN_PREVIEW=false
